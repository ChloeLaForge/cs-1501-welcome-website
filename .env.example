# Copy to .env.local and fill in with your Supabase project's values
# (Project Settings -> API). The anon key is safe for the browser: the
# course_questionnaire_responses table's RLS policy only allows anonymous
# INSERTs, never SELECT/UPDATE/DELETE. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Build Your AI Friend (server-side only -- deliberately NOT VITE_-prefixed,
# so Vite never inlines it into the browser bundle). Read only by
# server/aiServer.ts, which `npm run dev` starts alongside Vite. Get a key
# at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Build Your AI Friend persistence + $40 budget cap -- server-side only.
# This is the Supabase service_role key (Project Settings -> API), which
# bypasses Row Level Security entirely. It must NEVER be prefixed with
# VITE_ and must NEVER be put anywhere a browser could read it. Read only
# by server/supabaseAdmin.ts. If unset, Build an AI Friend fails closed
# (reports itself unavailable) -- see server/aiServer.ts's requireAiFriendAvailable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Build Your AI Friend pricing assumptions -- server-side only, used to
# reserve/reconcile spend against the $40 cap (see server/pricingConfig.ts
# for the full explanation and how to source these). If any is unset, the
# feature fails closed the same as a missing Supabase config above.
# USD per 1,000,000 tokens for the chat model (server/aiServer.ts's CHAT_MODEL).
OPENAI_CHAT_INPUT_PRICE_PER_1M_USD=
OPENAI_CHAT_OUTPUT_PRICE_PER_1M_USD=
# Flat USD price for one image at IMAGE_SIZE/IMAGE_QUALITY (server/aiServer.ts's IMAGE_MODEL).
OPENAI_IMAGE_PRICE_USD=

# Optional. Overrides the $40.00 default hard ceiling (see
# server/budgetConfig.ts). Leave unset to use the default.
COURSE_AI_BUDGET_CEILING_USD=

# Optional LOCAL DEVELOPMENT UI override. When exactly "true" and NODE_ENV
# is not "production", the AI Friend navigation/route remains visible even
# if the server-only Supabase/pricing settings above are absent. This affects
# only GET /api/ai-friend/availability: chat and image generation still fail
# closed unless normal persistence, pricing, and budget checks all succeed.
# It is ignored in production and must not be used as a spending bypass.
AI_FRIEND_DEV_VISIBLE=false

# Optional server runtime settings. The production server serves both dist/
# and /api from one origin. Set TRUST_PROXY_HOPS only when the selected host
# documents the exact number of trusted reverse proxies in front of Node;
# leaving it at 0 prevents spoofed X-Forwarded-For values from being trusted.
AI_FRIEND_SERVER_PORT=8790
TRUST_PROXY_HOPS=0
# Server-side OpenAI deadline. SDK automatic retries remain disabled so one
# browser action cannot silently produce duplicate paid provider calls.
OPENAI_REQUEST_TIMEOUT_MS=120000
